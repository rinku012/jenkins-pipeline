pipeline {
     agent any
    stages {
        stage('Pull') {
            steps {
             git branch: 'main', url: 'https://github.com/rinku012/ORS-Backend.git'
                
            }
        }
         stage('Build'){
            steps {
               sh '''cd demo
                      mvn clean install -DskipTests 
                  '''
        }         

      }
 
    }
}
